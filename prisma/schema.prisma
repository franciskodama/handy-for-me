generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String     @id @default(uuid()) @db.VarChar(255)
  uid                 String     @unique 
  name                String? 
  avatar              String? 
  hashedPassword      String?
  createdAt           DateTime   @default(now()) @db.Timestamp(6)
  householdId         String?    @db.VarChar(255)
  household           Household? @relation(fields: [householdId], references: [id])
  shareDecisionHelper Boolean    @default(true)
  shareBucketList     Boolean    @default(true)
}

model DecisionHelperList {
  id          String   @id @default(uuid()) @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  uid         String   
  list        String   
  items       DecisionHelperItem[]
  householdId String?  @db.VarChar(255)
}

model DecisionHelperItem {
  id        String   @id @default(uuid()) @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  uid       String   
  item      String   
  selected  Boolean   @default(true)
  list      DecisionHelperList @relation(fields: [listId], references: [id])
  listId    String
}

model DecisionHelperSubject {
  id          String   @id @default(uuid()) @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  uid         String   
  subject     String   
  items       DecisionHelperProsConsItem[]
  householdId String?  @db.VarChar(255)
}

model DecisionHelperProsConsItem {
  id        String   @id @default(uuid()) @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  uid       String   
  content   String   
  isPro     Boolean   @default(true)
  weight    Int       @default(1)
  subject   DecisionHelperSubject @relation(fields: [subjectId], references: [id])
  subjectId String
}

model VisualBoardItem {
  id        String   @id @default(uuid()) @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  uid       String   
  item      String   
  url       String
  done      Boolean
}

model BucketListItem {
  id          String   @id @default(uuid()) @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  uid         String   
  item        String   
  category    String
  done        Boolean
  householdId String?  @db.VarChar(255)
}

model ShortcutCategory {
  id        String   @id @default(uuid()) @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  uid       String   
  category  String   
  color     shortcut_color_enum    @default(GRAY)
  shortcuts Shortcut[]
}

model Shortcut {
  id        String   @id @default(uuid()) @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  uid       String   
  shortcut  String   
  url       String
  description String @default("No description yet")
  categoryId  String   
  category    ShortcutCategory @relation(fields: [categoryId], references: [id])
}

model WeeklyWin {
  id        String   @id @default(uuid()) @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  uid       String   
  goal      String   
  type      String
  done      Boolean
}

model YearPromise {
  id        String   @id @default(uuid()) @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt
  uid       String   
  title     String   
  year      Int      @default(2025)
  quarter   String   
  progress  Int      @default(0)
  done      Boolean  @default(false)
}

model Habit {
  id          String   @id @default(uuid()) @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  uid         String
  name        String
  lastResetAt DateTime @default(now()) @db.Timestamp(6)
  color       String?  @default("#ef4444")
  targetDate  DateTime? @db.Timestamp(6)
  history     HabitHistory[]
}

model HabitHistory {
  id          String   @id @default(uuid()) @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  habitId     String   @db.VarChar(255)
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  startedAt   DateTime @db.Timestamp(6)
  endedAt     DateTime @db.Timestamp(6)
  note        String?  @db.VarChar(500)
}


enum shortcut_color_enum {
  BLUE
  GREEN
  RED
  YELLOW
  PURPLE
  ORANGE
  PINK
  TEAL
  GRAY
  BROWN
  BLACK
}

model Household {
  id        String   @id @default(uuid()) @db.VarChar(255)
  code      String   @unique @db.VarChar(255)
  name      String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  users     User[]
}

model VisitedPlace {
  id        String   @id @default(uuid()) @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  uid       String   @db.VarChar(255)
  city      String   @db.VarChar(255)
  state     String?  @db.VarChar(255)
  country   String   @db.VarChar(255)
  lat       Float
  lng       Float
  notes     String?  @db.VarChar(1000)
  visitDate DateTime? @db.Timestamp(6)
}

model KanbanBoard {
  id        String         @id @default(uuid()) @db.VarChar(255)
  createdAt DateTime       @default(now()) @db.Timestamp(6)
  uid       String         @db.VarChar(255)
  title     String         @db.VarChar(255)
  emoji     String         @default("📋") @db.VarChar(10)
  order     Int            @default(0)
  columns   KanbanColumn[]
}

model KanbanColumn {
  id        String         @id @default(uuid()) @db.VarChar(255)
  createdAt DateTime       @default(now()) @db.Timestamp(6)
  uid       String         @db.VarChar(255)
  title     String         @db.VarChar(255)
  order     Int            @default(0)
  boardId   String         @db.VarChar(255)
  board     KanbanBoard    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tickets   KanbanTicket[]
}

model KanbanTicket {
  id          String       @id @default(uuid()) @db.VarChar(255)
  createdAt   DateTime     @default(now()) @db.Timestamp(6)
  updatedAt   DateTime     @updatedAt @db.Timestamp(6)
  uid         String       @db.VarChar(255)
  title       String       @db.VarChar(255)
  description String?      @db.VarChar(1000)
  priority    String       @default("NONE") @db.VarChar(50) // "Q1", "Q2", "Q3", "Q4", "NONE"
  order       Int          @default(0)
  columnId    String       @db.VarChar(255)
  column      KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
}